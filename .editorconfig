root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,toml,json,html,sh,bash,zsh,fish}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[crates/gilvt-theme/themes/**]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{jsonl,min.js}]
insert_final_newline = false
